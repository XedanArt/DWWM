{% extends "base.html.twig" %}

{% block seo %}
  <meta name="description" content="Morning Soul est une plateforme communautaire immersive mêlant jeu narratif, tutoriels, devblog et forum. Rejoignez l’aventure.">
  <meta name="robots" content="index, follow">

  {# Open Graph pour Discord, Facebook, LinkedIn… #}
  <meta property="og:title" content="Accueil - Morning Soul">
  <meta property="og:description" content="Explorez Morning Soul : tutoriels, support, devblog et forum communautaire. Chaque âme a son histoire.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ app.request.uri }}">
  <meta property="og:image" content="{{ asset('img/seo/discord_seo.png') }}">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Accueil - Morning Soul">
  <meta name="twitter:description" content="Rejoignez Morning Soul et découvrez une plateforme immersive mêlant jeu narratif, entraide et discussions.">
  <meta name="twitter:image" content="{{ asset('img/seo/twitter_seo.png') }}">
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block title %}Accueil{% endblock %}

{% block body %}
<!-- Conteneur principal de la page -->
<div class="ms-site-wrapper d-flex flex-column min-vh-100">
  <main class="container mt-5 ms-content-wrap flex-grow-1" role="main" aria-label="Page d’accueil Morning Soul">

    <!-- Conteneur Texte + Intro -->
    <header class="text-center mb-5" role="banner" aria-labelledby="home-heading">
      <h1 id="home-heading" class="ms-home-header">{{ title }}</h1>
      <p class="lead ms-home-intro">{{ subtitle }}</p>
      <p class="ms-home-intro-scnd">Chaque âme a son histoire...</p>
    </header>

    <section class="row" role="region" aria-label="Navigation vers les sections principales">
      <!-- Support & Aide -->
      <div class="col-md-4 mb-4">
        <article class="card ms-transparent-card" style="animation-delay: 0.2s;" role="region" aria-labelledby="support-heading">
          <div class="card-body">
            <h5 id="support-heading" class="card-title ms-card-title-custom">Support & Aide</h2>
            <p class="card-text ms-card-text-custom">Des réponses à vos questions, des tutoriels et une équipe prête à vous aider.</p>
            <a href="{{ path('contact.support') }}" class="btn ms-btn-custom" aria-label="Accéder à la page de support Morning Soul">Support</a>
          </div>
        </article>
      </div>

      <!-- Actualités & Devblogs -->
      <div class="col-md-4 mb-4">
        <article class="card h-100 ms-transparent-card" style="animation-delay: 0.4s;" role="region" aria-labelledby="news-heading">
          <div class="card-body">
            <h5 id="news-heading" class="card-title ms-card-title-custom">Actualités & Devblogs</h2>
            <p class="card-text ms-card-text-custom">Suivez l’évolution du projet, les changelogs et le devblog de l’équipe.</p>
            <a href="{{ path('news.devblog') }}" class="btn ms-btn-custom" aria-label="Voir les actualités et devblogs Morning Soul">Nouveautés</a>
          </div>
        </article>
      </div>

      <!-- Forum & Discussions -->
      <div class="col-md-4 mb-4">
        <article class="card h-100 ms-transparent-card" style="animation-delay: 0.6s;" role="region" aria-labelledby="forum-heading">
          <div class="card-body">
            <h5 id="forum-heading" class="card-title ms-card-title-custom">Forum & Discussions</h2>
            <p class="card-text ms-card-text-custom">Explorez les derniers sujets, participez aux débats ou posez vos questions.</p>
            <a href="/forum" class="btn ms-btn-custom" aria-label="Accéder au forum Morning Soul">Accéder au Forum</a>
          </div>
        </article>
      </div>
    </section>
  </main>
</div>
{% endblock %}