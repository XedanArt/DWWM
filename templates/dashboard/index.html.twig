{% extends 'base.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<main class="dashboard-wrapper" role="main" aria-label="Tableau de bord administrateur Morning Soul">
  <header>
    <h1 class="dashboard-title">Tableau de bord</h1>
  </header>

  {% if is_granted('ROLE_ADMIN') %}
    <section class="dashboard-section dashboard-stats" role="region" aria-labelledby="stats-title">
      <h2 id="stats-title">Statistiques</h2>
      <ul class="dashboard-stats-list">
        <li>Total utilisateurs : {{ users|length }}</li>
        <li>Bannis : {{ users|filter(u => u.isBanned())|length }}</li>
        <li>Admins : {{ users|filter(u => 'ROLE_ADMIN' in u.roles)|length }}</li>
        <li><a href="{{ path('dashboard.logs') }}" class="btn btn-outline-secondary btn-sm">Voir les logs admin</a></li>
      </ul>
    </section>

    <section class="dashboard-section" role="region" aria-labelledby="user-management-title">
      <h2 id="user-management-title">Gestion des utilisateurs</h2>

      <div class="dashboard-filters mb-3" role="search" aria-label="Filtres de recherche utilisateur">
        <label for="search-user" class="visually-hidden">Rechercher un pseudo ou email</label>
        <input type="text" id="search-user" class="form-control" placeholder="Rechercher un pseudo ou email..." aria-describedby="search-help">
        <div id="search-help" class="visually-hidden">Tapez un pseudo ou une adresse email pour filtrer la liste</div>

        <label for="role-filter" class="visually-hidden">Filtrer par rôle</label>
        <select id="role-filter" class="form-select mt-2" aria-label="Filtrer par rôle">
          <option value="">Tous les rôles</option>
          <option value="ROLE_USER">Utilisateurs</option>
          <option value="ROLE_ADMIN">Admins</option>
          <option value="banned">Bannis</option>
        </select>
      </div>

      {% if users is defined and users|length > 0 %}
        <ul class="user-list scrollable-user-list" role="list" aria-label="Liste des utilisateurs">
          {% for user in users %}
            <li class="user-item"
                role="listitem"
                data-username="{{ user.username|lower }}"
                data-email="{{ user.email|lower }}"
                data-role="{{ user.roles|join(',') }}"
                data-banned="{{ user.isBanned() ? 'true' : 'false' }}">
              <article aria-labelledby="user-{{ user.id }}-label">
                <span id="user-{{ user.id }}-label">{{ user.displayUsername }}</span>

                {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                  <span class="badge bg-warning text-dark ms-2">Superadmin</span>
                {% elseif 'ROLE_ADMIN' in user.roles %}
                  <span class="badge bg-info text-dark ms-2">Admin</span>
                {% endif %}
                {% if user.isBanned() %}
                  <span class="badge bg-danger ms-2">Banni jusqu’au {{ user.banUntil|date('d/m/Y H:i') }}</span>
                {% endif %}

                <button class="user-toggle"
                        onclick="toggleUserMenu('{{ user.id }}')"
                        aria-controls="user-menu-{{ user.id }}"
                        aria-expanded="false"
                        aria-label="Afficher les actions pour {{ user.displayUsername }}">▼</button>

                <div id="user-menu-{{ user.id }}" class="user-menu hidden" role="region" aria-label="Menu d’actions pour {{ user.displayUsername }}">
                  <p>Dernière connexion :
                    {% if user.lastLogin is not null %}
                      {{ user.lastLogin|date('d/m/Y H:i') }}
                    {% else %}
                      Jamais
                    {% endif %}
                  </p>
                  <p>Derniers topics : {{ user.topics|length }}</p>
                  <p>Derniers posts : {{ user.posts|length }}</p>

                  <div class="user-actions">
                    {% set isPrivilegedTarget = 'ROLE_ADMIN' in user.roles or 'ROLE_SUPER_ADMIN' in user.roles %}
                    {% set isSelf = user.id == app.user.id %}

                    {% if not isPrivilegedTarget %}
                      {% if not user.isBanned() %}
                        <a href="{{ path('dashboard.contact_user', { id: user.id }) }}">Contacter</a>

                        <form method="post" action="{{ path('dashboard.ban_user', { id: user.id, duration: 24 }) }}" class="confirm-action" aria-label="Bannir {{ user.displayUsername }} pour 24h">
                          <input type="hidden" name="_token" value="{{ csrf_token('ban-24-' ~ user.id) }}">
                          <button type="submit" class="btn btn-warning btn-sm">Bannir 24h</button>
                        </form>

                        <form method="post" action="{{ path('dashboard.ban_user', { id: user.id, duration: 48 }) }}" class="confirm-action" aria-label="Bannir {{ user.displayUsername }} pour 48h">
                          <input type="hidden" name="_token" value="{{ csrf_token('ban-48-' ~ user.id) }}">
                          <button type="submit" class="btn btn-warning btn-sm">Bannir 48h</button>
                        </form>
                      {% else %}
                        <div class="text-muted">Actions désactivées (utilisateur banni)</div>
                      {% endif %}

                      {% if not isSelf %}
                        <form method="post" action="{{ path('dashboard.delete_user', { id: user.id }) }}" class="confirm-action" aria-label="Supprimer {{ user.displayUsername }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                          <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                      {% endif %}
                    {% endif %}
                  </div>
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p role="status" aria-live="polite">Aucun utilisateur à afficher pour le moment.</p>
      {% endif %}

      <nav class="alphabet-filter mt-3" aria-label="Filtrage alphabétique des utilisateurs">
        {% for letter in 'A'..'Z' %}
          <button class="alphabet-button" onclick="filterUsersByLetter('{{ letter }}')" aria-label="Filtrer par {{ letter }}">{{ letter }}</button>
        {% endfor %}
        <button class="alphabet-button reset" onclick="resetUserFilter()" aria-label="Réinitialiser le filtre">Tous</button>
      </nav>
    </section>

    <section class="dashboard-section" role="region" aria-labelledby="content-user-title">
      <h2 id="content-user-title">Gestion contenu utilisateur</h2>
      <ul class="dashboard-actions">
        <li>
          <a href="{{ path('topic.quarantine.list') }}" class="btn btn-primary">Voir les topics en quarantaine</a>
        </li>
      </ul>
    </section>

    <section class="dashboard-section" role="region" aria-labelledby="content-management-title">
      <h2 id="content-management-title">Gérer le contenu</h2>
      <ul class="dashboard-actions">
        <li><a href="{{ path('admin.devblog.new') }}" class="btn btn-primary">Ajouter un Devblog</a></li>
        <li><a href="{{ path('admin.changelog.new') }}" class="btn btn-primary">Ajouter un Changelog</a></li>
        <li><a href="{{ path('admin.announcement.new') }}" class="btn btn-primary">Ajouter une annonce</a></li>
        <li><a href="{{ path('admin.entry.delete') }}" class="btn btn-danger"><i class="bi bi-trash3-fill me-1"></i> Suppression d'une entrée</a></li>
      </ul>
    </section>
  {% endif %}

  {% if is_granted('ROLE_SUPER_ADMIN') %}
    <section class="dashboard-section super-admin-panel" role="region" aria-labelledby="superadmin-title">
      <h2 id="superadmin-title">Panel Super Admin</h2>
      <ul class="dashboard-actions">
        <li><a href="{{ path('superadmin.create_admin') }}" class="btn btn-primary">Créer un administrateur</a></li>
        <li><a href="{{ path('superadmin.revoke_admin') }}" class="btn btn-danger">Révoquer un administrateur</a></li>
      </ul>
    </section>
  {% endif %}
</main>

<script>
function toggleUserMenu(id) {
  const menu = document.getElementById('user-menu-' + id);
  menu.classList.toggle('hidden');
}

function filterUsersByLetter(letter) {
  const users = document.querySelectorAll('.user-item');
  users.forEach(user => {
    const username = user.dataset.username.toUpperCase();
    user.style.display = username.startsWith(letter) ? 'block' : 'none';
  });
}

function resetUserFilter() {
  document.querySelectorAll('.user-item').forEach(user => user.style.display = 'block');
}

document.getElementById('search-user').addEventListener('input', function () {
  const query = this.value.toLowerCase();
  document.querySelectorAll('.user-item').forEach(user => {
    const username = user.dataset.username;
    const email = user.dataset.email;
    user.style.display = (username.includes(query) || email.includes(query)) ? 'block' : 'none';
  });
});

document.getElementById('role-filter').addEventListener('change', function () {
  const role = this.value;
  document.querySelectorAll('.user-item').forEach(user => {
    const roles = user.dataset.role;
    const banned = user.dataset.banned === 'true';
    if (role === '') {
      user.style.display = 'block';
    } else if (role === 'banned') {
      user.style.display = banned ? 'block' : 'none';
    } else {
      user.style.display = roles.includes(role) ? 'block' : 'none';
    }
  });
});

document.querySelectorAll('form.confirm-action').forEach(form => {
  form.addEventListener('submit', function (e) {
    const confirmed = confirm("Êtes-vous sûr de vouloir effectuer cette action ?");
    if (!confirmed) {
      e.preventDefault();
    }
  });
});
</script>
{% endblock %}