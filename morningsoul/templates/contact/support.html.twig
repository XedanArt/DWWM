{% extends "base.html.twig" %}

{% block seo %}
  <meta name="description" content="Besoin d’aide sur Morning Soul ? Contactez notre support technique ou consultez la FAQ pour les questions fréquentes.">
  <meta name="robots" content="index, follow">

  {# Open Graph pour les aperçus sociaux (Discord, Facebook, LinkedIn…) #}
  <meta property="og:title" content="Support - Morning Soul">
  <meta property="og:description" content="Notre équipe support est disponible pour répondre à vos questions, signaler un bug ou vous assister dans le jeu.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ app.request.uri }}">
  <meta property="og:image" content="{{ asset('img/seo/discord_seo.png') }}">

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Support - Morning Soul">
  <meta name="twitter:description" content="Contactez le support Morning Soul ou consultez notre FAQ pour toute assistance technique ou gameplay.">
  <meta name="twitter:image" content="{{ asset('img/seo/twitter_seo.png') }}">
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/support.css') }}">
{% endblock %}

{% block title %}Support{% endblock %}

{% block body %}
  <div class="support-separator"></div>

  <section class="support-section" role="region" aria-labelledby="support-heading">
    <div class="support-wrapper">
      <div class="support-container">

        {# Paramètre de validation formulaire #}
        {% for message in app.flashes('success') %}
          <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite" aria-label="Message de confirmation">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer le message de confirmation"></button>
          </div>
        {% endfor %}

        {# Formulaire de contact #}
        <div class="container mt-5">
          <h2 id="support-heading" class="mb-4">Contactez le support</h2>
          {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            <div class="mb-3">
              {{ form_label(form.nom) }}
              {{ form_widget(form.nom, {
                'attr': {
                  'class': 'form-control',
                  'aria-describedby': 'nomHelp'
                }
              }) }}
              <small id="nomHelp" class="form-text text-muted">Votre nom complet</small>
              {{ form_errors(form.nom) }}
            </div>
            <div class="mb-3">
              {{ form_label(form.email) }}
              {{ form_widget(form.email, {
                'attr': {
                  'class': 'form-control',
                  'aria-describedby': 'emailHelp'
                }
              }) }}
              <small id="emailHelp" class="form-text text-muted">Adresse email valide</small>
              {{ form_errors(form.email) }}
            </div>
            <div class="mb-3">
              {{ form_label(form.message) }}
              {{ form_widget(form.message, {
                'attr': {
                  'class': 'form-control',
                  'rows': '5',
                  'aria-describedby': 'messageHelp'
                }
              }) }}
              <small id="messageHelp">Votre message ou demande</small>
              {{ form_errors(form.message) }}
            </div>
            <button type="submit" class="btn btn-primary" aria-label="Envoyer le formulaire de contact">Envoyer</button>
          {{ form_end(form) }}
        </div>

        <div class="support-faq" role="region" aria-labelledby="faq-heading">
          <h3 id="faq-heading">FAQ</h3>
          <ul>
            <li><strong>Comment signaler un bug ?</strong> Utilisez le formulaire ci-dessus ou envoyez un email à <a href="mailto:contact@morningsoul.fr">contact@morningsoul.fr</a>.</li>
            <li><strong>Quels sont les horaires du support ?</strong> Du lundi au vendredi, de 9h à 18h (CET).</li>
            <li><strong>Où trouver les mises à jour du jeu ?</strong> Consultez les pages <a href="{{ path('news.changelog') }}">changelogs</a> et <a href="{{ path('news.devblog') }}">devblogs</a>.</li>
          </ul>
        </div>

        <div class="support-email" role="contentinfo" aria-label="Coordonnées email du support">
          <p>Vous pouvez également nous contacter directement par email à <a href="mailto:contact@morningsoul.fr">contact@morningsoul.fr</a>.</p>
        </div>
      </div>

      <div class="support-sidebar" role="complementary" aria-label="Informations annexes sur le support">
        <p>Une question sur le jeu ou son gameplay ?</p>
        <a href="{{ path('forum.index') }}">Accédez au forum</a>
      </div>
    </div>
  </section>

  <script>
  (() => {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });

    const successAlert = document.querySelector('.alert-success');
    if (successAlert) {
      const form = document.querySelector('.needs-validation');
      if (form) form.reset();
    }
  })();
  </script>
{% endblock %}